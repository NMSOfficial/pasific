GEMINI_API_KEY=
PORT=8787
# Comma-separated list of frontend origins allowed to call this API
# (your Vercel production domain + any preview URLs you test from).
CORS_ORIGIN=

# Client-side (exposed to the browser — safe, RLS-protected)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the deployed grading API (server/), e.g. https://pasific-api.up.railway.app
# Leave empty for local dev — Vite's proxy (vite.config.ts) forwards /api to localhost:8787.
VITE_API_URL=

# Server-side only — never expose to the browser bundle
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password reset emails (server/passwordReset.ts). Without these, recovery
# links are still generated but only logged to the server console, not
# actually emailed. Sign up at https://resend.com, verify a sending domain,
# and set RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Deployed frontend origin, e.g. https://pasific.vercel.app — used as the
# redirect target after a user clicks the recovery link. Must also be added
# to Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs
# as "<APP_ORIGIN>/reset-password".
APP_ORIGIN=
